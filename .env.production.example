# ===== هداياك — إعدادات البرودكشن (Hostinger Premium) =====
# انسخ الملف دا على السيرفر باسم .env واملأ القيم اللي عليها <...>

APP_NAME="هداياك"
APP_ENV=production
APP_KEY=            # هنولده على السيرفر بـ: php artisan key:generate
APP_DEBUG=false
APP_URL=https://hdayak.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=daily
LOG_LEVEL=error

# --- الداتابيز: من hPanel -> Databases -> MySQL Databases ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<اسم_الداتابيز_من_hPanel>
DB_USERNAME=<اليوزر_من_hPanel>
DB_PASSWORD=<الباسورد_من_hPanel>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# --- الإيميل: اعمل إيميل orders@hdayak.com من hPanel -> Emails ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=orders@hdayak.com
MAIL_PASSWORD=<باسورد_الإيميل>
MAIL_FROM_ADDRESS=orders@hdayak.com
MAIL_FROM_NAME="هداياك"
